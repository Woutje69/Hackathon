    {
        "id": "5214a476a8b2350d",
        "type": "function",
        "z": "23e9aa8649696eec",
        "g": "122fb1b19da0d76a",
        "name": "controleer nummer",
        "func": "if(global.get(\"started\")) {\n    let colour = msg.payload;\n    msg.topic = \"EscapeGame/Number\";\n    let kleurcode = global.get(\"kleurcode\");\n\n    msg.payload = kleurcode.indexOf(\"ROOD\") + 1;\n\n    if(colour.includes(\"ROOD\")) {\n        msg.payload = kleurcode.indexOf(\"ROOD\")+1;\n        return msg;\n    }\n    else if(colour.includes(\"BLAUW\")) {\n        msg.payload = kleurcode.indexOf(\"BLAUW\")+1;\n        return msg;\n    }\n    else if(colour.includes(\"GROEN\")) {\n        msg.payload = kleurcode.indexOf(\"GROEN\")+1;\n        return msg;\n    }\n    else if(colour.includes(\"GEEL\")) {\n        msg.payload = kleurcode.indexOf(\"GEEL\")+1;\n        return msg;\n    }\n    else {\n        msg.payload = 0;\n        return msg;\n    }\n}",
