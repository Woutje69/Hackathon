        "name": "function 4",
        "func": "let input = msg.payload;\nlet inputArr = (input.trim()).split(\" \");\nlet codeArr = global.get(\"cijfercode\");\nlet foutGespot = false;\n\nif(global.get(\"started\")) {\n\n    for (let index = 0; index < 4; index++) {\n        if(inputArr[index] != codeArr[index]) {\n            foutGespot = true;\n        }\n    }\n\n   \n    if(!foutGespot) {\n        msg.payload = false;\n        global.set(\"win\", true);\n        return msg;\n    }\n    else {\n        msg.payload = \"Foute volgorde, begin volledig opnieuw\";\n        global.set(\"foutecode\", true);\n        return msg;\n    }\n}",
