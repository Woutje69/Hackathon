        "g": "1d2bc8bc812c9d02",
        "name": "function 1",
        "func": "if(msg.payload == false) {\n    if(global.get(\"win\") && global.get(\"started\")) {\n        msg.payload = \"Je hebt gewonnen, proficiat\";\n        return msg;\n    }\n    else {\n        msg.payload = \"Jammer, je hebt verloren.\";\n        return msg;\n    }\n}\nelse if(msg.payload == 60) {\n    msg.payload = \"Je hebt nog 60 seconden de tijd\";\n    return msg;\n}\nelse if(msg.payload == 119) {\n    if(global.get(\"foutecode\") && global.get(\"started\")) {\n        msg.payload = \"Foute code, begin volledig opnieuw\";\n    }\n    else if (!global.get(\"foutecode\")){\n        msg.payload = \"Spel gestart, vindt de juiste kleurcode\";\n    }\n    return msg;\n}\nelse return msg;",
